# Copy this file to `.env` for local development and fill in the values.
# On Vercel (or another host), add the same names under Project → Settings → Environment Variables.
# Never commit a real `.env` file — it is already listed in `.gitignore`.

# ── Booking enquiry emails (Resend) ─────────────────────────────────────────
# API key from https://resend.com/api-keys  (server-side only — never prefix with NEXT_PUBLIC_)
RESEND_API_KEY=

# Inbox that receives booking enquiries. Separate several addresses with commas.
BOOKING_TO_EMAIL=

# Sender identity. Use an address on a domain you have verified in Resend, e.g.
#   BOOKING_FROM_EMAIL="Website Enquiries <bookings@your-domain.com>"
# If left empty, Resend's test sender (onboarding@resend.dev) is used. The test sender
# can only deliver to the email address of your own Resend account.
BOOKING_FROM_EMAIL=

# ── Site ────────────────────────────────────────────────────────────────────
# Public URL of the deployed site, used for canonical links and social previews.
# Example: https://www.your-domain.com
NEXT_PUBLIC_SITE_URL=

# ── Not required ────────────────────────────────────────────────────────────
# The website does not use a database. DATABASE_URL is only read by the unused
# starter scaffolding in `src/db` and can be left unset.
# DATABASE_URL=
